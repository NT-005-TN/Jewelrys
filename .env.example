# Copy this file to .env and replace every placeholder before running Docker Compose.
POSTGRES_DB=jewelry_workshop
POSTGRES_USER=jewelry
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Generate at least 64 random bytes and Base64-encode them.
JWT_SECRET=
JWT_ISSUER=jewelry-workshop-api
JWT_AUDIENCE=jewelry-workshop-clients

SERVER_PORT=8080
MAILPIT_UI_PORT=8025
OPENAPI_ENABLED=true
APP_PUBLIC_BASE_URL=http://localhost:8080/api
APP_FRONTEND_BASE_URL=http://localhost:3000

# Optional one-time bootstrap. Disable it immediately after the first successful start.
ADMIN_INIT_ENABLED=false
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
